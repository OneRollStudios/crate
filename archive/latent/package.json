{
  "name": "@latent/react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Latent — React components for AI-native interfaces.",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist-lib"
  ],
  "main": "./dist-lib/latent.js",
  "module": "./dist-lib/latent.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/latent.js"
    },
    "./styles.css": "./dist-lib/latent.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node -e \"require('fs').cpSync('public/fonts','dist-lib/fonts',{recursive:true})\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1"
  }
}
